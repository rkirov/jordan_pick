# Lake build artifacts and fetched dependencies (incl. the Mathlib cache)
/.lake
build/
*.olean
*.ilean
*.trace

# Verso documentation site (site/) build artifacts. The sources
# (site/lakefile.toml, site/lean-toolchain, site/lake-manifest.json, site/Main.lean,
# site/Site.lean, site/Site/, site/404.html) are tracked; these are not.
/site/.lake/
/site/_out/

# External references consulted during development. NOT part of the build, and
# includes third-party material (papers, other repos) that must not be
# redistributed. Keep this out of the repo.
/reference/

# Generated lean-eval submission bundle — regenerate with
# `submission/bundle-engine.sh`. The script + README + toolchain are tracked;
# the bundled copy of the engine is not.
/submission/Submission/

# Editor / OS noise
.DS_Store
*.swp
